#!/bin/sh
# Pre-push contrast smoke check.
#
# CI (.github/workflows/contrast-gate.yml) is the authoritative gate and audits seven pages at two
# widths. That takes minutes, which is too slow to sit in front of every push — so this hook runs a
# fast subset: the two surfaces that have actually regressed before (the homepage's cream acts and the
# book's gradient cover) at one width. Roughly 40 seconds.
#
# Design rules, deliberately:
#   * FAIL-OPEN on missing tooling. A push must never be blocked because Chrome or Pillow is absent
#     on this machine — that is not a defect in the code being pushed. It warns and lets you through;
#     CI still has the final say.
#   * FAIL-CLOSED on an actual contrast failure. That is the whole point.
#   * Escape hatch: SKIP_CONTRAST=1 git push
#
# Enabled via:  git config core.hooksPath .githooks

set -u

[ "${SKIP_CONTRAST:-0}" = "1" ] && { echo "pre-push: contrast check skipped (SKIP_CONTRAST=1)"; exit 0; }

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

# Only bother when something that can change rendering is being pushed.
RANGE=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if git rev-parse --verify --quiet "origin/$RANGE" >/dev/null 2>&1; then
  CHANGED=$(git diff --name-only "origin/$RANGE"...HEAD 2>/dev/null)
else
  CHANGED=$(git diff --name-only HEAD~1...HEAD 2>/dev/null)
fi
# svg/png/jpg are in this list deliberately. On 2026-08-02 a broken SVG shipped and sat live
# on /process; had someone pushed an SVG-only change, the old html|css|js filter would have
# skipped every gate and waved it straight through.
if [ -n "$CHANGED" ] && ! printf '%s\n' "$CHANGED" | grep -qE '\.(html|css|js|svg|png|jpe?g|webp)$'; then
  echo "pre-push: no renderable changes — visual checks not needed"
  exit 0
fi

command -v python3 >/dev/null 2>&1 || { echo "pre-push: python3 missing — skipping contrast check"; exit 0; }
python3 -c 'import PIL' 2>/dev/null   || { echo "pre-push: Pillow missing (pip install pillow) — skipping contrast check"; exit 0; }
[ -f tools/contrast-audit.py ]        || { echo "pre-push: tools/contrast-audit.py missing — skipping"; exit 0; }

# Pick a free port so this never collides with a dev server already running.
PORT=$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')
python3 -m http.server "$PORT" --directory . >/dev/null 2>&1 &
SRV=$!
trap 'kill $SRV 2>/dev/null; rm -f __ca_*.html' EXIT INT TERM

i=0
while [ $i -lt 40 ]; do
  curl -sf -o /dev/null "http://localhost:$PORT/" && break
  i=$((i+1)); sleep 0.25
done
curl -sf -o /dev/null "http://localhost:$PORT/" || { echo "pre-push: local server did not start — skipping"; exit 0; }

# ---------------------------------------------------------------------------
# The heavy gates each boot their own Chrome and re-render the same 50 pages.
# Run serially that was ~20 minutes of doing the identical work five times.
# They are independent, so fire them all now, in the background, and collect
# the verdicts further down where each gate's own message already lives.
# Nothing about what is checked changes — only that the waiting overlaps.
# ---------------------------------------------------------------------------
GATEDIR=$(mktemp -d)
trap 'kill $SRV 2>/dev/null; rm -f __ca_*.html; rm -rf "$GATEDIR"' EXIT INT TERM

bg_gate() {  # bg_gate <name> <cmd...>
  _n="$1"; shift
  ( if "$@" >"$GATEDIR/$_n.log" 2>&1; then echo OK; else echo FAIL; fi \
      >"$GATEDIR/$_n.status" ) &
}
# Print a finished gate's output and return its exit status.
wait_gate() {  # wait_gate <name>
  while [ ! -f "$GATEDIR/$1.status" ]; do sleep 0.3; done
  cat "$GATEDIR/$1.log"
  [ "$(cat "$GATEDIR/$1.status")" = OK ]
}

echo "pre-push: starting the browser gates in parallel…"
[ -f tools/asset-load-check.py ] && bg_gate asset-load \
  python3 tools/asset-load-check.py --docroot . --no-selftest \
  "http://localhost:$PORT/" "http://localhost:$PORT/process/"
[ -f tools/artifact-legibility-check.py ] && bg_gate artifact-legibility \
  python3 tools/artifact-legibility-check.py
[ -f tools/cta-viewport-check.py ] && bg_gate cta-viewport \
  python3 tools/cta-viewport-check.py
[ -f tools/component-identity-check.py ] && bg_gate component-identity \
  python3 tools/component-identity-check.py
[ -f tools/image-alignment-check.py ] && bg_gate image-alignment \
  python3 tools/image-alignment-check.py --all --widths 390,1440
bg_gate contrast \
  python3 tools/contrast-audit.py --docroot . --widths 1440 \
  --exempt '.bk-device__label, .bk-device__mark, .grad' \
  --force-visible '.reveal' \
  "http://localhost:$PORT/" "http://localhost:$PORT/book/"


# Canon lint first — it is pure text, costs under a second, and catches the failure that actually
# escaped review (a retired term still printed on the book cover). No reason to make you wait for
# Chrome before hearing about a wrong word.
if [ -f tools/canon-lint.py ]; then
  echo "pre-push: canon lint…"
  if ! python3 tools/canon-lint.py --root .; then
    cat <<'MSG'

pre-push: BLOCKED — a canon violation (or a broken linter) was reported above.

  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# Book/classic case drift — pure text, sub-second, and catches stale duplicated facts.
if [ -f tools/case-sync-check.py ]; then
  echo "pre-push: case-study sync (book vs classic)…"
  if ! python3 tools/case-sync-check.py --root .; then
    echo ""
    echo "pre-push: BLOCKED — the book and the classic case pages disagree (see above)."
    echo "  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push"
    echo ""
    exit 1
  fi
fi

# Do every asset actually PAINT? Added 2026-08-02, after the /process method diagram was found
# to have been a broken image on the live site: a literal angle-bracket tag inside a CSS comment
# made the SVG invalid XML, and an SVG loaded through an img element must be valid XML. Every
# other gate here checks text, agreement or colour — none of them asked whether the picture
# loaded. The static half costs milliseconds and catches that exact root cause across the whole
# tree; the runtime half re-checks the two pages that carry the most diagrams.
if [ -f tools/asset-load-check.py ]; then
  echo "pre-push: asset load check (SVG validity + images actually painting)…"
  if ! wait_gate asset-load; then
    cat <<'MSG'

pre-push: BLOCKED — a broken asset was detected above.

  An SVG that fails XML parsing renders as a BROKEN IMAGE when loaded via an img tag.
  Most common cause: a literal angle-bracket tag inside the SVG's <style> block, even in
  a comment. Fix it, or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# STRUCTURE, not correctness. Added 2026-08-02 after the site was found to hold 2,095 inline
# style attributes whose type declarations duplicated each other 562 times — every duplicate an
# independent fork, several already drifted. Canon-lint, contrast, case-sync and asset-load all
# passed throughout: they check whether a page is RIGHT, never whether it is STRUCTURED.
# Artifact legibility. Added 2026-08-15 after invisible text reached production:
# the diagrams became inlined SVG so the brand fonts would apply, and nothing had
# ever looked INSIDE one — they used to be <img> files no CSS could touch. Two
# defects shipped together (leaked artifact stylesheets, an incomplete colour
# remap) and every other gate passed them. Arpit found it by eye.
if [ -f tools/artifact-legibility-check.py ]; then
  echo "pre-push: artifact legibility (can a reader see the text inside the diagrams?)…"
  if ! wait_gate artifact-legibility; then
    cat <<'MSG'

pre-push: BLOCKED — text inside an artifact is invisible against its own background.

  Usually an artifact's <style> leaking into the page (scope it to the artifact's
  id), or a colour applied to the text but not to the box behind it.
  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push
MSG
    exit 1
  fi
  echo "pre-push: artifact legibility OK."
fi

# 2026-08-16 — the CANON gate sat red in CI for days on a check this hook never ran:
# teardown-facts --check. Every published "hand-written HTML pages / OG cards / skip-link
# pages" number on lab/teardown.html is measured, and adding any page makes them stale.
# A check that only runs AFTER the push is a check you learn about too late; it belongs here.
# 2026-08-16 — the homepage's PRIMARY CTA wore a flat fill on every phone while the nav CTA
# beside it carried the gradient, and no gate could see it: cta-grammar-check renders at 1440
# only and excludes pills, contrast measures legibility not consistency. A phone and a laptop
# must agree about what a component IS.
if [ -f tools/cta-viewport-check.py ]; then
  echo "pre-push: CTA viewport identity (does a button change below 640px?)…"
  if ! wait_gate cta-viewport; then
    echo "pre-push: BLOCKED — a call-to-action renders differently on phone and desktop."
    exit 1
  fi
fi

# The cta-viewport gate compares a button to ITSELF across widths on one page.
# It cannot see two pages at once, which is how the same button shipped as a
# flat gold slab on six case studies and a gradient pill on three. Arpit found
# it by opening two case studies side by side.
if [ -f tools/component-identity-check.py ]; then
  echo "pre-push: component identity (does one component look the same on every page?)…"
  if ! wait_gate component-identity; then
    echo
    echo "pre-push: BLOCKED — a component renders differently on different pages."
    echo "  Name it once, on the component. A page-scoped rule is how this comes back."
    exit 1
  fi
fi

if [ -f tools/teardown-facts.py ]; then
  echo "pre-push: teardown facts (are the published counts still true?)…"
  if ! python3 tools/teardown-facts.py --check; then
    echo "pre-push: BLOCKED — lab/teardown.html publishes a number that is no longer true."
    echo "          Run: python3 tools/teardown-facts.py   (then update the page), and retry."
    exit 1
  fi
fi

# Same reasoning: a stylesheet edited without bumping its ?v= means browsers keep serving the
# old file under the same URL. That cost a full misdiagnosis once; CI catching it is too late.
if [ -f tools/css-version-check.py ]; then
  echo "pre-push: css version check (stylesheet edited without a cache bump?)…"
  if ! python3 tools/css-version-check.py; then
    echo "pre-push: BLOCKED — a stylesheet changed but its ?v= did not. Run tools/bump-css-version.py."
    exit 1
  fi
fi

# The fit check is the only page that answers a stranger's question ABOUT ARPIT. Two gates:
# the index must be rebuildable (every citation resolves, every number traced to a published
# page), and the matcher must still refuse the controls — an earlier lexicon matched
# "leadership" on a pastry chef's "manage the ovens" and nothing on screen revealed it.
if [ -f tools/build-fit-index.py ]; then
  echo "pre-push: fit index (does every claim still trace to a published page?)…"
  if ! python3 tools/build-fit-index.py; then
    echo "pre-push: BLOCKED — a fit-index claim cites a missing page or an unpublished number."
    exit 1
  fi
  if ! git diff --quiet -- data/fit-index.json 2>/dev/null; then
    echo "pre-push: BLOCKED — data/fit-index.json is stale. It was just rebuilt; commit it."
    exit 1
  fi
fi

if [ -f tools/fit-check-calibration.py ]; then
  echo "pre-push: fit-check calibration (do the controls still come back empty?)…"
  if ! python3 tools/fit-check-calibration.py "http://localhost:$PORT"; then
    echo "pre-push: BLOCKED — the fit check is over- or under-matching. See the failing case above."
    exit 1
  fi
fi

if [ -f tools/inline-style-check.py ]; then
  echo "pre-push: inline-style check (is a repeated component still unnamed?)…"
  if ! python3 tools/inline-style-check.py --root .; then
    cat <<'MSG'

pre-push: BLOCKED — a type treatment is duplicated inline instead of being a class.

  Add it to styles.css and put the class on the elements. Repeated inline styles are how
  this site ended up with one mono label spelled 16 different ways.
  Or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# .grad is gradient-clipped text (background-clip:text; color:transparent). A
# computed-style sampler reads the transparent fallback and reports the
# impossible "#170D17 on #170D17" — identical colours, i.e. the instrument
# failing, not the page. Measured from rendered pixels 2026-08-15: the hero
# glyphs are rgb(244,155,149) on rgb(19,11,22) = 9.16:1 against a 3.0 bar.
echo "pre-push: contrast smoke check (homepage + book cover, 1440px)…"
# .bk-device__label / __mark: CONFIRMED 2026-08-17 by rendering the element — it is the
# circled AM monogram with "HUMAN IN THE LOOP" as its letterspaced wordmark beneath, i.e. a
# logo lockup on a depicted device. WCAG 1.4.3 exempts text that is part of a logo or brand
# name, so the 2.68:1 the audit reports there is correct and deliberate. The gate prints
# "confirm that is true" every run; this comment is the confirmation, so the next person
# does not re-litigate it or, worse, recolour a logotype to satisfy a checker.
# (This comment lived INSIDE the \-continuation below and silently mangled the command —
#  `sh -n` reported valid syntax while the invocation was broken. Comments never go between
#  continued arguments.)
wait_gate contrast
STATUS=$?

if [ $STATUS -ne 0 ]; then
  cat <<'MSG'

pre-push: BLOCKED — a contrast failure (or a broken checker) was detected above.

  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push
  Full audit, all colour contexts: see .github/workflows/contrast-gate.yml

MSG
  exit 1
fi

echo "pre-push: contrast OK."
exit 0

# ── partials are the source; a page that has drifted from them must not ship ──
# The nav and footer live in partials/ and are stamped into every page by
# tools/build-partials.py. Editing a page's nav by hand puts it back where it
# was before the architecture review: 37 navs that were all supposed to be one.
if [ -f tools/build-partials.py ]; then
  echo "pre-push: partials (has any page drifted from the shared nav/footer?)…"
  if ! python3 tools/build-partials.py --check | grep -q "drifted from the partials : 0"; then
    python3 tools/build-partials.py --check
    echo
    echo "pre-push: BLOCKED — a page's nav or footer differs from partials/."
    echo "  Edit partials/nav.html or partials/footer.html, then run:"
    echo "     python3 tools/build-partials.py"
    exit 1
  fi
  echo "pre-push: partials OK."
fi

# ── images: cut off, clipped, broken, stretched or unsized ────────────────────
# Added after Arpit found figures sliced off the left edge on /case-studies/o2
# while five gates were green. Every other gate here begins by asking whether
# an element has TEXT, so images were outside the suite entirely.
if [ -f tools/image-alignment-check.py ]; then
  echo "pre-push: image alignment (is anything cut off, clipped or broken?)…"
  if ! wait_gate image-alignment; then
    echo
    echo "pre-push: BLOCKED — an image is off-viewport, clipped, broken or stretched."
    echo "  A figure a reader cannot see whole is a figure that is not making its point."
    exit 1
  fi
  echo "pre-push: image alignment OK."
fi
