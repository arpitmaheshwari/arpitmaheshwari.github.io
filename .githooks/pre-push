#!/bin/sh
# Pre-push contrast smoke check.
#
# CI (.github/workflows/contrast-gate.yml) is the authoritative gate and audits seven pages at two
# widths. That takes minutes, which is too slow to sit in front of every push — so this hook runs a
# fast subset: the two surfaces that have actually regressed before (the homepage's cream acts and the
# book's gradient cover) at one width. Roughly 40 seconds.
#
# Design rules, deliberately:
#   * FAIL-OPEN on missing tooling. A push must never be blocked because Chrome or Pillow is absent
#     on this machine — that is not a defect in the code being pushed. It warns and lets you through;
#     CI still has the final say.
#   * FAIL-CLOSED on an actual contrast failure. That is the whole point.
#   * Escape hatch: SKIP_CONTRAST=1 git push
#
# Enabled via:  git config core.hooksPath .githooks

set -u

[ "${SKIP_CONTRAST:-0}" = "1" ] && { echo "pre-push: contrast check skipped (SKIP_CONTRAST=1)"; exit 0; }

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

# Only bother when something that can change rendering is being pushed.
RANGE=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if git rev-parse --verify --quiet "origin/$RANGE" >/dev/null 2>&1; then
  CHANGED=$(git diff --name-only "origin/$RANGE"...HEAD 2>/dev/null)
else
  CHANGED=$(git diff --name-only HEAD~1...HEAD 2>/dev/null)
fi
# svg/png/jpg are in this list deliberately. On 2026-08-02 a broken SVG shipped and sat live
# on /process; had someone pushed an SVG-only change, the old html|css|js filter would have
# skipped every gate and waved it straight through.
if [ -n "$CHANGED" ] && ! printf '%s\n' "$CHANGED" | grep -qE '\.(html|css|js|svg|png|jpe?g|webp)$'; then
  echo "pre-push: no renderable changes — visual checks not needed"
  exit 0
fi

command -v python3 >/dev/null 2>&1 || { echo "pre-push: python3 missing — skipping contrast check"; exit 0; }
python3 -c 'import PIL' 2>/dev/null   || { echo "pre-push: Pillow missing (pip install pillow) — skipping contrast check"; exit 0; }
[ -f tools/contrast-audit.py ]        || { echo "pre-push: tools/contrast-audit.py missing — skipping"; exit 0; }

# Pick a free port so this never collides with a dev server already running.
PORT=$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')
python3 -m http.server "$PORT" --directory . >/dev/null 2>&1 &
SRV=$!
trap 'kill $SRV 2>/dev/null; rm -f __ca_*.html' EXIT INT TERM

i=0
while [ $i -lt 40 ]; do
  curl -sf -o /dev/null "http://localhost:$PORT/" && break
  i=$((i+1)); sleep 0.25
done
curl -sf -o /dev/null "http://localhost:$PORT/" || { echo "pre-push: local server did not start — skipping"; exit 0; }

# Canon lint first — it is pure text, costs under a second, and catches the failure that actually
# escaped review (a retired term still printed on the book cover). No reason to make you wait for
# Chrome before hearing about a wrong word.
if [ -f tools/canon-lint.py ]; then
  echo "pre-push: canon lint…"
  if ! python3 tools/canon-lint.py --root .; then
    cat <<'MSG'

pre-push: BLOCKED — a canon violation (or a broken linter) was reported above.

  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# Book/classic case drift — pure text, sub-second, and catches stale duplicated facts.
if [ -f tools/case-sync-check.py ]; then
  echo "pre-push: case-study sync (book vs classic)…"
  if ! python3 tools/case-sync-check.py --root .; then
    echo ""
    echo "pre-push: BLOCKED — the book and the classic case pages disagree (see above)."
    echo "  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push"
    echo ""
    exit 1
  fi
fi

# Do every asset actually PAINT? Added 2026-08-02, after the /process method diagram was found
# to have been a broken image on the live site: a literal angle-bracket tag inside a CSS comment
# made the SVG invalid XML, and an SVG loaded through an img element must be valid XML. Every
# other gate here checks text, agreement or colour — none of them asked whether the picture
# loaded. The static half costs milliseconds and catches that exact root cause across the whole
# tree; the runtime half re-checks the two pages that carry the most diagrams.
if [ -f tools/asset-load-check.py ]; then
  echo "pre-push: asset load check (SVG validity + images actually painting)…"
  if ! python3 tools/asset-load-check.py --docroot . --no-selftest \
        "http://localhost:$PORT/" "http://localhost:$PORT/process/"; then
    cat <<'MSG'

pre-push: BLOCKED — a broken asset was detected above.

  An SVG that fails XML parsing renders as a BROKEN IMAGE when loaded via an img tag.
  Most common cause: a literal angle-bracket tag inside the SVG's <style> block, even in
  a comment. Fix it, or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# STRUCTURE, not correctness. Added 2026-08-02 after the site was found to hold 2,095 inline
# style attributes whose type declarations duplicated each other 562 times — every duplicate an
# independent fork, several already drifted. Canon-lint, contrast, case-sync and asset-load all
# passed throughout: they check whether a page is RIGHT, never whether it is STRUCTURED.
# Artifact legibility. Added 2026-08-15 after invisible text reached production:
# the diagrams became inlined SVG so the brand fonts would apply, and nothing had
# ever looked INSIDE one — they used to be <img> files no CSS could touch. Two
# defects shipped together (leaked artifact stylesheets, an incomplete colour
# remap) and every other gate passed them. Arpit found it by eye.
if [ -f tools/artifact-legibility-check.py ]; then
  echo "pre-push: artifact legibility (can a reader see the text inside the diagrams?)…"
  if ! python3 tools/artifact-legibility-check.py; then
    cat <<'MSG'

pre-push: BLOCKED — text inside an artifact is invisible against its own background.

  Usually an artifact's <style> leaking into the page (scope it to the artifact's
  id), or a colour applied to the text but not to the box behind it.
  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push
MSG
    exit 1
  fi
  echo "pre-push: artifact legibility OK."
fi

if [ -f tools/inline-style-check.py ]; then
  echo "pre-push: inline-style check (is a repeated component still unnamed?)…"
  if ! python3 tools/inline-style-check.py --root .; then
    cat <<'MSG'

pre-push: BLOCKED — a type treatment is duplicated inline instead of being a class.

  Add it to styles.css and put the class on the elements. Repeated inline styles are how
  this site ended up with one mono label spelled 16 different ways.
  Or push anyway with:   SKIP_CONTRAST=1 git push

MSG
    exit 1
  fi
fi

# .grad is gradient-clipped text (background-clip:text; color:transparent). A
# computed-style sampler reads the transparent fallback and reports the
# impossible "#170D17 on #170D17" — identical colours, i.e. the instrument
# failing, not the page. Measured from rendered pixels 2026-08-15: the hero
# glyphs are rgb(244,155,149) on rgb(19,11,22) = 9.16:1 against a 3.0 bar.
echo "pre-push: contrast smoke check (homepage + book cover, 1440px)…"
python3 tools/contrast-audit.py \
  --docroot . --widths 1440 \
  --exempt '.bk-device__label, .bk-device__mark, .grad' \
  --force-visible '.reveal' \
  "http://localhost:$PORT/" "http://localhost:$PORT/book/"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  cat <<'MSG'

pre-push: BLOCKED — a contrast failure (or a broken checker) was detected above.

  Fix it, or push anyway with:   SKIP_CONTRAST=1 git push
  Full audit, all colour contexts: see .github/workflows/contrast-gate.yml

MSG
  exit 1
fi

echo "pre-push: contrast OK."
exit 0
